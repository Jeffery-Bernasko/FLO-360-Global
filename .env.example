# Postgres connection string. Use a Neon database URL in production.
# Local dev example: postgres://postgres:postgres@localhost:5432/flo360
DATABASE_URL=

# Random secret used by Auth.js to sign session tokens.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed app (used by Auth.js callbacks). Optional in local dev.
# AUTH_URL=https://flo360.example.com

# --- Filled in by later features (placeholders) ---
# Vercel Blob token (used by F5/F6 attachment uploads)
# BLOB_READ_WRITE_TOKEN=

# Warehouse identity used on invoices (used by F6)
# WAREHOUSE_NAME="FLO 360 Global"
# WAREHOUSE_CONTACT="+233 XX XXX XXXX"
